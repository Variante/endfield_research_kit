  "representation": {
    "controlStates": {
      "0": "not_in_scene",
      "1": "insert_pending",
      "2": "in_scene",
      "3": "remove_pending"
    },
    "membershipBoundary": "direct: API scene for insert_pending/in_scene only; fully registered claim requires in_scene. Non-null stored scene alone is insufficient.",
    "contactBoundary": "unresolved: normal fetchResults dispatches raw report pairs directly before post-callback stream/actor-pair cleanup. Split-results headers are built lazily; no recorded event or current touching-pair claim follows from their empty count.",
    "genericSceneGetterBoundary": "direct: registration-state policy matches the specialized static release. Its generic actor-offset lookup uses unbacked BSS; the reader uses the specialized static offset operand instead of treating that table as captured.",
    "reportBoundary": "structuralOnly: report core/count/entries consumers are authenticated; actor pair record fields and physical contact semantics are not decoded.",
    "reportingConfigurationBoundary": "direct conditional: the complete constructor preserves its descriptor argument and sends its callback slot through the reviewed setter; descriptor filter slots are copied to scene fields. The setter writes the callback-consumer field tested by report dispatch. This authenticates the configuration route, not a non-null runtime callback, a selected filter shader, pair flags or delivered reports."
  },
