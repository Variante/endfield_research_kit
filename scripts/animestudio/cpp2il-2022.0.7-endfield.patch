+        private static void NormalizeGenericConstraints(ModuleDefinition module, IGenericParameterProvider provider, ref int imported, ref int skipped)
+        {
+            if (!provider.HasGenericParameters)
+                return;
+
+            foreach (var parameter in provider.GenericParameters)
+            {
+                for (var index = parameter.Constraints.Count - 1; index >= 0; index--)
+                {
+                    var constraint = parameter.Constraints[index];
+                    var constraintType = constraint.ConstraintType;
+                    if (constraintType.Module == module)
+                        continue;
+
+                    try
+                    {
+                        if (constraintType is GenericParameter)
+                            throw new InvalidOperationException("A generic parameter constraint cannot be owned by another module.");
+                        constraint.ConstraintType = module.ImportReference(constraintType);
+                        imported++;
+                    }
+                    catch (Exception e)
+                    {
+                        parameter.Constraints.RemoveAt(index);
+                        skipped++;
+                        Logger.WarnNewline($"Skipping malformed generic constraint for {module.Name}:{provider}.{parameter.Name} ({constraintType.FullName}): {e.GetType().Name}.");
+                    }
+                }
+            }
+        }
