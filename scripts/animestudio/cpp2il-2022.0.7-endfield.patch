+        private static IEnumerable<TypeDefinition> EnumerateTypes(IEnumerable<TypeDefinition> roots)
+        {
+            foreach (var type in roots)
+            {
+                yield return type;
+                foreach (var nestedType in EnumerateTypes(type.NestedTypes))
+                    yield return nestedType;
+            }
+        }
