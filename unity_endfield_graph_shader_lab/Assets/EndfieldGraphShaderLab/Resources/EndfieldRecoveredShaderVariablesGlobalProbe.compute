// Reads both exact selected pass-0 b35 names as raw 32-bit words.

#pragma kernel Readback
#pragma target 5.0

cbuffer ShaderVariablesGlobal
{
    float4 _EndfieldRecoveredShaderVariablesGlobalVectors[200];
};

cbuffer EndfieldCB1
{
    float4 _EndfieldRecoveredShaderVariablesGlobalDxbcVectors[157];
};

float _EndfieldRecoveredShaderVariablesGlobalReady;
RWStructuredBuffer<uint> _EndfieldRecoveredShaderVariablesGlobalReadback;

[numthreads(1, 1, 1)]
void Readback(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    _EndfieldRecoveredShaderVariablesGlobalReadback[0] =
        asuint(_EndfieldRecoveredShaderVariablesGlobalReady);
    [unroll]
    for (uint vectorIndex = 0u; vectorIndex < 200u; ++vectorIndex)
    {
        uint4 bits = asuint(
            _EndfieldRecoveredShaderVariablesGlobalVectors[vectorIndex]);
        uint wordBase = 1u + vectorIndex * 4u;
        _EndfieldRecoveredShaderVariablesGlobalReadback[wordBase + 0u] = bits.x;
        _EndfieldRecoveredShaderVariablesGlobalReadback[wordBase + 1u] = bits.y;
        _EndfieldRecoveredShaderVariablesGlobalReadback[wordBase + 2u] = bits.z;
        _EndfieldRecoveredShaderVariablesGlobalReadback[wordBase + 3u] = bits.w;
    }
    [unroll]
    for (uint vectorIndex = 0u; vectorIndex < 157u; ++vectorIndex)
    {
        uint4 bits = asuint(
            _EndfieldRecoveredShaderVariablesGlobalDxbcVectors[vectorIndex]);
        uint wordBase = 801u + vectorIndex * 4u;
        _EndfieldRecoveredShaderVariablesGlobalReadback[wordBase + 0u] = bits.x;
        _EndfieldRecoveredShaderVariablesGlobalReadback[wordBase + 1u] = bits.y;
        _EndfieldRecoveredShaderVariablesGlobalReadback[wordBase + 2u] = bits.z;
        _EndfieldRecoveredShaderVariablesGlobalReadback[wordBase + 3u] = bits.w;
    }
}
