// Reads both bindings used for the selected pass-0 b31 constant buffer.

#pragma kernel ReadbackNamed
#pragma kernel ReadbackBridge
#pragma target 5.0

cbuffer _LightDataBuffer
{
    float4 _EndfieldRecoveredDeferredLightDataVectors[2054];
};

cbuffer EndfieldCB4
{
    float4 _EndfieldRecoveredDeferredLightDataBridgeVectors[2054];
};

float _EndfieldRecoveredDeferredLightDataReady;
RWStructuredBuffer<uint> _EndfieldRecoveredDeferredLightDataReadback;

void WriteVector(uint vectorIndex, float4 value)
{
    uint4 bits = asuint(value);
    uint wordBase = 1u + vectorIndex * 4u;
    _EndfieldRecoveredDeferredLightDataReadback[wordBase + 0u] = bits.x;
    _EndfieldRecoveredDeferredLightDataReadback[wordBase + 1u] = bits.y;
    _EndfieldRecoveredDeferredLightDataReadback[wordBase + 2u] = bits.z;
    _EndfieldRecoveredDeferredLightDataReadback[wordBase + 3u] = bits.w;
}

[numthreads(1, 1, 1)]
void ReadbackNamed(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    _EndfieldRecoveredDeferredLightDataReadback[0] =
        asuint(_EndfieldRecoveredDeferredLightDataReady);
    for (uint vectorIndex = 0u; vectorIndex < 2054u; ++vectorIndex)
        WriteVector(vectorIndex, _EndfieldRecoveredDeferredLightDataVectors[vectorIndex]);
}

[numthreads(1, 1, 1)]
void ReadbackBridge(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    _EndfieldRecoveredDeferredLightDataReadback[0] =
        asuint(_EndfieldRecoveredDeferredLightDataReady);
    for (uint vectorIndex = 0u; vectorIndex < 2054u; ++vectorIndex)
        WriteVector(vectorIndex, _EndfieldRecoveredDeferredLightDataBridgeVectors[vectorIndex]);
}
