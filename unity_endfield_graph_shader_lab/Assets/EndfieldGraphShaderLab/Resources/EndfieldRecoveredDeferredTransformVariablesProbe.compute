// Reads the exact selected pass-0 _TransformVariables b30 binding.

#pragma kernel Readback
#pragma target 5.0

cbuffer _TransformVariables
{
    float4 _EndfieldRecoveredDeferredTransformVectors[82];
};

float _EndfieldRecoveredDeferredTransformVariablesReady;
RWStructuredBuffer<uint> _EndfieldRecoveredDeferredTransformReadback;

[numthreads(1, 1, 1)]
void Readback(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    _EndfieldRecoveredDeferredTransformReadback[0] =
        asuint(_EndfieldRecoveredDeferredTransformVariablesReady);
    [unroll]
    for (uint vectorIndex = 0u; vectorIndex < 82u; ++vectorIndex)
    {
        uint4 bits = asuint(
            _EndfieldRecoveredDeferredTransformVectors[vectorIndex]);
        uint wordBase = 1u + vectorIndex * 4u;
        _EndfieldRecoveredDeferredTransformReadback[wordBase + 0u] = bits.x;
        _EndfieldRecoveredDeferredTransformReadback[wordBase + 1u] = bits.y;
        _EndfieldRecoveredDeferredTransformReadback[wordBase + 2u] = bits.z;
        _EndfieldRecoveredDeferredTransformReadback[wordBase + 3u] = bits.w;
    }
}
