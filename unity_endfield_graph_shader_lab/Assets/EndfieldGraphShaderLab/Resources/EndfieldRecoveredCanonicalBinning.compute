// Transport bridge for the exact installed combined _BinningBuffer ABI.
// The source is the recovered light XY/Z segment. The selected CharInfo scene
// has no local reflection probes, so every word in the reflection segment is
// source-closed zero. This helper is not claimed as original shader bytecode.

#pragma kernel BuildCanonicalCombined
#pragma kernel ReadCanonicalGlobal

StructuredBuffer<uint> _EndfieldRecoveredLightBinningBuffer;
RWByteAddressBuffer _EndfieldRecoveredCanonicalBinningBuffer;
ByteAddressBuffer _BinningBuffer;
RWStructuredBuffer<uint> _EndfieldRecoveredCanonicalBinningReadback;

int _EndfieldRecoveredCanonicalLightWordCount;
int _EndfieldRecoveredCanonicalCombinedWordCount;

[numthreads(64, 1, 1)]
void BuildCanonicalCombined(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    uint wordIndex = dispatchThreadID.x;
    if (wordIndex >= (uint)_EndfieldRecoveredCanonicalCombinedWordCount)
        return;

    uint value = wordIndex < (uint)_EndfieldRecoveredCanonicalLightWordCount
        ? _EndfieldRecoveredLightBinningBuffer[wordIndex]
        : 0u;
    _EndfieldRecoveredCanonicalBinningBuffer.Store(wordIndex * 4u, value);
}

[numthreads(64, 1, 1)]
void ReadCanonicalGlobal(uint3 dispatchThreadID : SV_DispatchThreadID)
{
    uint wordIndex = dispatchThreadID.x;
    if (wordIndex >= (uint)_EndfieldRecoveredCanonicalCombinedWordCount)
        return;
    _EndfieldRecoveredCanonicalBinningReadback[wordIndex] =
        _BinningBuffer.Load(wordIndex * 4u);
}
